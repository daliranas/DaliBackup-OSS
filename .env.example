# ========================================================
# DaliBackup-OSS Configuration Environment
# ========================================================

# Server Port
PORT=3000
HOST=0.0.0.0

# Security (JWT & Token Encryption)
JWT_SECRET=change_this_to_a_secure_random_string_32_chars_minimum
AGENT_API_TOKEN=dalibkp_oss_secure_token_for_hyperv_agents

# Single-User Initial Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.local

# Storage Default Local Path (for NFS / Local Mounts)
DEFAULT_LOCAL_STORAGE_PATH=./data/backups

# App Base Data Directory
DATABASE_FILE=./data/dalibackup.db
